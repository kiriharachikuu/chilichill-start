# 运行环境：development | production | test（生产环境必须显式设置）
NODE_ENV=development

# 数据库连接（相对 apps/api/prisma 目录）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥：生产环境必须配置至少 32 位的随机密钥（缺失或为默认值时拒绝启动）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="spaceport-dev-secret-change-me"

# 部署在反向代理（Nginx 等）之后才设为 true，否则客户端可伪造 X-Forwarded-For 绕过 IP 限流
TRUST_PROXY=""

# 跨域白名单，逗号分隔完整 Origin，例如 https://a.com,https://b.com
# 前后端同源部署（或开发走 Vite 代理）无需配置；未配置时生产环境拒绝所有跨域请求
CORS_ORIGINS=""

# API 监听端口
API_PORT=3001

# 对外访问地址（拼接上传文件 URL）
PUBLIC_BASE_URL="http://localhost:3001"

# 腾讯云 COS（可选，全部留空时使用本地 public/uploads）
# 共享存储桶必配 COS_KEY_PREFIX：上传对象统一落在该目录下（如 spaceport/uploads/2026/11/...），与其他项目的文件隔离
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
COS_BASE_URL=""
COS_KEY_PREFIX="spaceport"

# ---------------- Resend 验证码邮件（注册 / 找回密码） ----------------
# 在 https://resend.com/api-keys 创建密钥，仅在后端配置
# 开发/测试留空时仅打印邮件并返回 devCode；生产环境必须配置
RESEND_API_KEY=""
# 启用 Resend 时必填：使用已在 Resend 验证的域名，填写纯邮箱地址
MAIL_FROM=""
MAIL_FROM_NAME="厚嘴唇空间站"
MAIL_REPLY_TO=""
MAIL_MAX_RETRIES=2
MAIL_RETRY_DELAY_MS=800

EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_HOURLY_LIMIT=5
EMAIL_CODE_IP_HOURLY_LIMIT=20
